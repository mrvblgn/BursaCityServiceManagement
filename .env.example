# ==============================================================================
# Bursa City Service Management System (BCSMS) - Local Environment Configuration
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# NOTE: All values here are development-only placeholders. Do not use in production.
# ==============================================================================

# SQL Server SA Password (must meet SQL Server password complexity requirements)
SA_PASSWORD=BcsmsLocalDevPassword2026!

# JWT Secret Key (minimum 256 bits / 32 characters)
JWT_SECRET=BursaCityServiceManagementSystemSafeDevelopmentKey2026!

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Startup Flags
DATABASE_APPLY_MIGRATIONS=true
DATABASE_SEED_DEMO_DATA=true
